---
import { SITE } from '../config/site';
import ui from '../content/ui.json';
import Nav from '../components/Nav.astro';
import Loader from '../components/Loader.astro';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = `${SITE.name} — Product Designer`, description = SITE.description } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} dir={SITE.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF6EF" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preload" href="/fonts/ClashDisplay-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeneralSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Loader gate: decide before first paint (first visit per session, motion-safe only) -->
    <script is:inline>
      (function () {
        try {
          var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduced && !sessionStorage.getItem('visited')) {
            document.documentElement.setAttribute('data-loader', 'on');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Loader line={ui.loader.line} />
    <Nav />
    <main id="main">
      <slot />
    </main>

    <!-- Footer stub — full Contact/Footer section pending its own approval (IA §3.8) -->
    <footer class="footer-stub">
      <div class="container footer-stub__row">
        <span class="t-meta">{ui.footer.copyright}</span>
        <span class="footer-stub__links">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={SITE.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={SITE.links.resume} target="_blank" rel="noopener">Resume ↓</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .footer-stub {
    border-block-start: 1px solid var(--border);
    padding-block: var(--space-6);
    background: var(--bg-tint);
  }
  .footer-stub__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    color: var(--ink-soft);
  }
  .footer-stub__links {
    display: flex;
    gap: var(--space-5);
    font-size: var(--text-meta);
  }
  .footer-stub__links a { text-decoration-color: var(--coral); text-underline-offset: 3px; }
</style>
