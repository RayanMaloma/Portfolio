---
// Playground — one continuous mixed collage (revision 2026-07-18).
// No per-project chapter sections: all curated boards interleave in a single
// masonry flow on one background that continues from the header. Each card
// carries a small caption with the project's own accent as a detail, not a
// section-wide world. Legacy anchors (#rknh …) target each project's first card.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ui from '../content/ui.json';

const projects = (await getCollection('playground')).sort((a, b) => a.data.order - b.data.order);
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));

// Scale rhythm (approved 2026-07-18): full-width showcase → pair → repeat.
// Wide boards take FULL slots; tall/square pieces sit in PAIRs. Curated order
// gives every project a big moment; first occurrence carries the legacy anchor.
type Ref = [string, number]; // [project id, index into its images array]
const sequence: { layout: 'full' | 'pair'; refs: Ref[] }[] = [
  { layout: 'full', refs: [['rknh', 0]] },
  { layout: 'pair', refs: [['routine', 3], ['mosbah', 0]] },
  { layout: 'full', refs: [['routine', 0]] },
  { layout: 'pair', refs: [['tamakan', 0], ['rknh', 2]] },
  { layout: 'full', refs: [['mosbah', 1]] },
  { layout: 'pair', refs: [['rknh', 1], ['routine', 1]] },
  { layout: 'full', refs: [['rknh', 3]] },
  { layout: 'pair', refs: [['routine', 2], ['tamakan', 1]] },
  { layout: 'full', refs: [['mosbah', 2]] },
  { layout: 'full', refs: [['mosbah', 3]] },
];
const seen = new Set<string>();
const groups = sequence.map((g) => ({
  layout: g.layout,
  items: g.refs.map(([id, idx]) => {
    const p = byId[id];
    const img = p.data.images[idx];
    const anchor = seen.has(id) ? undefined : id;
    seen.add(id);
    return { src: img.src, alt: img.alt, title: p.data.title, kind: p.data.kind, accent: p.data.accent, anchor };
  }),
}));
---

<Base
  title="Playground — Rayan Al-Omaireeni"
  description="Graphic design work by Rayan Al-Omaireeni: brand identities, campaigns and visual systems for RKNH, Routine, Tamakkan and Mosbah Omar."
>
  <header class="pg-head">
    <div class="container">
      <a class="pg-head__back t-meta" href="/">{ui.playground.backHome}</a>
      <div class="pg-head__row">
        <h1 class="pg-head__title t-display">{ui.playground.title.toUpperCase()}</h1>
        <img class="pg-head__memoji" src="/assets/memoji.webp" alt="" width="96" loading="eager" aria-hidden="true" />
      </div>
      <p class="pg-head__intro" data-reveal>{ui.playground.pageIntro}</p>
      <p class="pg-head__legend t-meta" data-reveal>
        {projects.map((p) => (
          <span class="pg-head__legend-item"><i style={`background:${p.data.accent}`}></i>{p.data.title}</span>
        ))}
      </p>
    </div>
  </header>

  <section class="pg-board" aria-label="Selected graphic design work">
    <div class="container">
      {groups.map((g) => (
        <div class:list={['pg-row', `pg-row--${g.layout}`]}>
          {g.items.map((item) => (
            <figure class="pg-card" id={item.anchor} data-reveal>
              <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
              <figcaption class="pg-card__meta t-meta">
                <i class="pg-card__dot" style={`background:${item.accent}`} aria-hidden="true"></i>
                <span class="pg-card__title">{item.title}</span>
                <span class="pg-card__kind">{item.kind}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  /* Header and board share ONE ground — the page reads as a single space */
  .pg-head {
    padding-block: calc(var(--space-9) + 40px) var(--space-6);
    background: var(--bg-tint);
  }
  .pg-head__back { color: var(--ink-soft); text-decoration: none; }
  .pg-head__back:hover { color: var(--coral-deep); }
  .pg-head__row { display: flex; align-items: flex-end; gap: var(--space-4); }
  .pg-head__title {
    font-size: clamp(3rem, 12vw, 10rem);
    line-height: 0.9;
    margin-block-start: var(--space-6);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
  }
  .pg-head__memoji {
    inline-size: clamp(56px, 7vw, 96px);
    transform: rotate(8deg);
    translate: 0 12%;
  }
  .pg-head__intro {
    margin-block-start: var(--space-5);
    max-inline-size: 58ch;
    color: var(--ink-soft);
    font-size: var(--text-lead);
  }
  .pg-head__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-5);
    color: var(--ink-soft);
  }
  .pg-head__legend-item { display: inline-flex; align-items: center; gap: var(--space-2); }
  .pg-head__legend-item i {
    inline-size: 10px;
    block-size: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .pg-board { background: var(--bg-tint); padding-block: var(--space-6) var(--space-section); }

  /* Scale rhythm: full-width showcase rows alternate with 2-up pairs.
     Cards always follow the artwork's natural aspect ratio. */
  .pg-row { margin-block-end: var(--space-8); }
  .pg-row--pair {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gutter);
    align-items: start;
  }
  /* slight vertical offset on the pair's second piece — editorial stagger */
  .pg-row--pair .pg-card:nth-child(2) { margin-block-start: var(--space-7); }

  .pg-card {
    margin: 0;
    scroll-margin-block-start: 120px; /* legacy #anchors land below the fixed nav */
  }
  .pg-card img {
    inline-size: 100%;
    block-size: auto;
    display: block;
    border-radius: var(--r-m);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .pg-card:hover img { transform: translateY(-3px); }
  .pg-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
    color: var(--muted);
  }
  .pg-card__dot {
    inline-size: 9px;
    block-size: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .pg-card__title { color: var(--ink-soft); font-weight: 600; }
  .pg-card__kind { color: var(--muted); }

  @media (max-width: 767px) {
    .pg-row--pair { grid-template-columns: 1fr; }
    .pg-row--pair .pg-card:nth-child(2) { margin-block-start: 0; }
    .pg-row { margin-block-end: var(--space-6); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pg-card img { transition: none; }
  }
</style>
