---
// Playground — one continuous mixed collage (revision 2026-07-18).
// No per-project chapter sections: all curated boards interleave in a single
// masonry flow on one background that continues from the header. Each card
// carries a small caption with the project's own accent as a detail, not a
// section-wide world. Legacy anchors (#rknh …) target each project's first card.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ui from '../content/ui.json';

const projects = (await getCollection('playground')).sort((a, b) => a.data.order - b.data.order);
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));

// Scale rhythm WITHIN each project (revision 2026-07-18): every project's
// boards are sequential deck pages, so they stay together and in order.
// Groups flow on one shared background — a slim label separates them, never
// a full chapter section. Layouts: full (wide showcase), pair (2-up),
// poster (tall/square art centered at reduced width, uncropped).
const projectRows: { id: string; rows: { layout: 'full' | 'pair' | 'poster'; refs: number[] }[] }[] = [
  { id: 'rknh', rows: [ { layout: 'full', refs: [0] }, { layout: 'pair', refs: [1, 2] }, { layout: 'full', refs: [3] } ] },
  { id: 'routine', rows: [ { layout: 'full', refs: [0] }, { layout: 'pair', refs: [1, 2] }, { layout: 'poster', refs: [3] } ] },
  { id: 'tamakan', rows: [ { layout: 'pair', refs: [0, 1] } ] },
  { id: 'mosbah', rows: [ { layout: 'pair', refs: [0, 1] }, { layout: 'full', refs: [2] }, { layout: 'full', refs: [3] } ] },
];
const groups = projectRows.map((g) => {
  const p = byId[g.id];
  return {
    id: g.id,
    title: p.data.title,
    kind: p.data.kind,
    year: p.data.year,
    accent: p.data.accent,
    rows: g.rows.map((r) => ({
      layout: r.layout,
      items: r.refs.map((idx) => p.data.images[idx]),
    })),
  };
});
---

<Base
  title="Playground — Rayan Al-Omaireeni"
  description="Graphic design work by Rayan Al-Omaireeni: brand identities, campaigns and visual systems for RKNH, Routine, Tamakkan and Mosbah Omar."
>
  <header class="pg-head">
    <div class="container">
      <a class="pg-head__back t-meta" href="/">{ui.playground.backHome}</a>
      <div class="pg-head__row">
        <h1 class="pg-head__title t-display">{ui.playground.title.toUpperCase()}</h1>
        <img class="pg-head__memoji" src="/assets/memoji.webp" alt="" width="96" loading="eager" aria-hidden="true" />
      </div>
      <p class="pg-head__intro" data-reveal>{ui.playground.pageIntro}</p>
      <p class="pg-head__legend t-meta" data-reveal>
        {projects.map((p) => (
          <span class="pg-head__legend-item"><i style={`background:${p.data.accent}`}></i>{p.data.title}</span>
        ))}
      </p>
    </div>
  </header>

  <section class="pg-board" aria-label="Selected graphic design work">
    <div class="container">
      {groups.map((g) => (
        <div class="pg-group" id={g.id}>
          <p class="pg-group__label t-meta" data-reveal>
            <i class="pg-group__dot" style={`background:${g.accent}`} aria-hidden="true"></i>
            <span class="pg-group__title">{g.title}</span>
            <span class="pg-group__kind">{g.kind}{g.year && ` · ${g.year}`}</span>
          </p>
          {g.rows.map((row) => (
            <div class:list={['pg-row', `pg-row--${row.layout}`]}>
              {row.items.map((item) => (
                <figure class="pg-card" data-reveal>
                  <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  /* Header and board share ONE ground — the page reads as a single space */
  .pg-head {
    padding-block: calc(var(--space-9) + 40px) var(--space-6);
    background: var(--bg-tint);
  }
  .pg-head__back { color: var(--ink-soft); text-decoration: none; }
  .pg-head__back:hover { color: var(--coral-deep); }
  .pg-head__row { display: flex; align-items: flex-end; gap: var(--space-4); }
  .pg-head__title {
    font-size: clamp(3rem, 12vw, 10rem);
    line-height: 0.9;
    margin-block-start: var(--space-6);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
  }
  .pg-head__memoji {
    inline-size: clamp(56px, 7vw, 96px);
    transform: rotate(8deg);
    translate: 0 12%;
  }
  .pg-head__intro {
    margin-block-start: var(--space-5);
    max-inline-size: 58ch;
    color: var(--ink-soft);
    font-size: var(--text-lead);
  }
  .pg-head__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-block-start: var(--space-5);
    color: var(--ink-soft);
  }
  .pg-head__legend-item { display: inline-flex; align-items: center; gap: var(--space-2); }
  .pg-head__legend-item i {
    inline-size: 10px;
    block-size: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .pg-board { background: var(--bg-tint); padding-block: var(--space-6) var(--space-section); }

  /* Projects stay together, in deck order; scale rhythm runs WITHIN a group.
     Groups are separated by a slim label only — never a chapter section. */
  .pg-group {
    margin-block-end: var(--space-10);
    scroll-margin-block-start: 120px; /* legacy #anchors land below the fixed nav */
  }
  .pg-group:last-child { margin-block-end: 0; }
  .pg-group__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
    border-block-start: 1px solid var(--border);
    padding-block-start: var(--space-4);
  }
  .pg-group__dot { inline-size: 10px; block-size: 10px; border-radius: 50%; flex-shrink: 0; }
  .pg-group__title { color: var(--ink); font-weight: 600; }
  .pg-group__kind { color: var(--muted); }

  .pg-row { margin-block-end: var(--gutter); }
  .pg-row:last-child { margin-block-end: 0; }
  .pg-row--pair {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gutter);
    align-items: start;
  }
  /* tall/square art gets a centered poster row — reduced width, never cropped */
  .pg-row--poster { display: flex; justify-content: center; }
  .pg-row--poster .pg-card { inline-size: min(520px, 72%); }

  .pg-card { margin: 0; }
  .pg-card img {
    inline-size: 100%;
    block-size: auto;
    display: block;
    border-radius: var(--r-m);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .pg-card:hover img { transform: translateY(-3px); }

  @media (max-width: 767px) {
    .pg-row--pair { grid-template-columns: 1fr; }
    .pg-row--poster .pg-card { inline-size: 100%; }
    .pg-group { margin-block-end: var(--space-8); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pg-card img { transition: none; }
  }
</style>
