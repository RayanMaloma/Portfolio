---
// What I Do — editorial typographic direction (P10, decision 24).
// Each pillar is one display-scale statement line; sub-capabilities hang off
// it as small annotations. Type carries the section — no cards, no numbers.
import ui from '../content/ui.json';
---

<section class="pos" id="what-i-do" aria-label="What I do">
  <div class="container">
    <header class="pos__head">
      <p class="t-meta pos__label" data-reveal>{ui.positioning.label}</p>
      <p class="pos__statement" data-reveal>{ui.positioning.statement}</p>
    </header>

    <ul class="pos__lines" role="list">
      {ui.positioning.pillars.map((p) => (
        <li class="pos__row" data-reveal>
          <h3 class="pos__line t-display">{p.title}</h3>
          <div class="pos__notes">
            <p class="pos__note">{p.line}</p>
            <p class="pos__subs t-meta">
              {p.subs.map((s, i) => (
                <span>{s}{i < p.subs.length - 1 && <i aria-hidden="true"> · </i>}</span>
              ))}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pos { padding-block: var(--space-section); background: var(--bg-base); }

  .pos__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .pos__label { color: var(--coral-deep); }
  .pos__statement {
    font-size: var(--text-lead);
    color: var(--ink-soft);
    max-inline-size: 44ch;
    text-wrap: balance;
  }

  .pos__lines { list-style: none; margin: var(--space-7) 0 0; padding: 0; }
  .pos__row {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-3) var(--gutter);
    align-items: start;
    border-block-start: 1px solid var(--border);
    padding-block: var(--space-6);
    transition: padding-inline-start var(--dur-2) var(--ease-out);
  }
  .pos__row:last-child { border-block-end: 1px solid var(--border); }

  .pos__line {
    font-size: clamp(2rem, 4.6vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--ink);
    transition: color var(--dur-1);
  }
  .pos__notes { padding-block-start: 0.5em; }
  .pos__note { color: var(--ink-soft); max-inline-size: 38ch; }
  .pos__subs { margin-block-start: var(--space-3); color: var(--ink-soft); }
  .pos__subs i { font-style: normal; color: var(--coral); }

  @media (hover: hover) and (pointer: fine) {
    .pos__row:hover { padding-inline-start: var(--space-4); }
    .pos__row:hover .pos__line { color: var(--coral-deep); }
  }

  @media (max-width: 1023px) {
    .pos__row { grid-template-columns: 1fr; }
    .pos__notes { padding-block-start: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pos__row, .pos__line { transition: none; }
  }
</style>
