---
// Hero — Option 1 "Inline Interruption" (approved 2026-07-17, DECISION_LOG P1).
// Full-bleed environmental photo under a coral wash; two-line display wordmark
// pinned to the bottom edge; a real project-UI card sits inline in line one.
// PHOTO IS A LABELED TEMP ASSET — replace per ASSET_MANIFEST.md §2 shoot brief.
import ui from '../content/ui.json';
---

<section class="hero" id="hero" data-hero>
  <picture class="hero__media" data-hero-media>
    <source media="(max-width: 767px)" srcset="/assets/hero/hero-scene-mobile.webp" />
    <img
      src="/assets/hero/hero-scene-1920.webp"
      srcset="/assets/hero/hero-scene-1080.webp 1080w, /assets/hero/hero-scene-1920.webp 1920w"
      sizes="100vw"
      alt="Rayan working at a warmly lit desk"
      fetchpriority="high"
    />
  </picture>
  <div class="hero__wash hero__wash--multiply" aria-hidden="true"></div>
  <div class="hero__wash hero__wash--screen" aria-hidden="true"></div>
  <!-- Photographic scrim: keeps the wordmark legible over bright photo regions
       (reference sites use the same device; this is treatment, not decoration) -->
  <div class="hero__scrim" aria-hidden="true"></div>

  <p class="hero__kicker t-meta" data-hero-kicker>{ui.hero.kicker}</p>

  <span class="hero__temp-tag t-meta" data-hero-kicker>{ui.hero.tempPhotoLabel}</span>

  <h1 class="hero__wordmark t-display">
    <span class="hero__line hero__line--1">
      <span class="hero__mask"><span class="hero__text" data-hero-line>{ui.hero.firstName}</span></span>
      <span class="hero__card" data-hero-card>
        <img src="/assets/hero/card-autorag.webp" alt={ui.hero.cardAlt} loading="eager" />
      </span>
    </span>
    <span class="hero__line hero__line--2">
      <span class="hero__mask"><span class="hero__text" data-hero-line>{ui.hero.lastName}</span></span>
    </span>
  </h1>

  <a class="hero__cue t-meta" href="#work" data-hero-kicker>{ui.hero.scrollCue}</a>
</section>

<style>
  .hero {
    position: relative;
    min-block-size: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--bg-deep);
  }

  .hero__media,
  .hero__media img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 28%;
  }
  .hero__media img { filter: saturate(0.8) contrast(0.96); }

  .hero__wash { position: absolute; inset: 0; pointer-events: none; }
  .hero__wash--multiply { background: var(--coral); opacity: 0.3; mix-blend-mode: multiply; }
  .hero__wash--screen { background: var(--coral-soft); opacity: 0.22; mix-blend-mode: screen; }
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(58, 26, 12, 0.58) 0%, rgba(58, 26, 12, 0) 48%);
  }

  .hero__kicker {
    position: absolute;
    inset-inline-start: var(--gutter);
    inset-block-start: clamp(96px, 22vh, 220px);
    color: var(--on-photo);
    z-index: 3;
  }

  .hero__temp-tag {
    position: absolute;
    inset-inline-start: var(--gutter);
    inset-block-end: clamp(240px, 38vh, 420px);
    z-index: 3;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1.5px dashed var(--coral-deep);
    border-radius: var(--r-s);
    padding: var(--space-1) var(--space-3);
    transform: rotate(-2deg);
  }

  .hero__wordmark {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.02em;
    padding-inline: var(--gutter);
    padding-block-end: var(--space-5);
    color: var(--on-photo);
    font-size: var(--text-hero);
    line-height: 0.88;
    font-weight: 600;
  }
  .hero__line { display: flex; align-items: center; gap: 0.18em; }
  .hero__line--2 { justify-content: flex-end; }
  .hero__mask { overflow: hidden; display: inline-block; }
  .hero__text { display: inline-block; }

  .hero__card {
    display: inline-block;
    inline-size: clamp(90px, 15vw, 240px);
    border-radius: var(--r-s);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transform: rotate(-3deg);
    flex-shrink: 0;
  }
  .hero__card img { inline-size: 100%; block-size: auto; }

  .hero__cue {
    position: absolute;
    inset-inline-end: var(--gutter);
    inset-block-start: clamp(96px, 22vh, 220px); /* mirrors the kicker */
    z-index: 3;
    color: var(--on-photo-soft);
    text-decoration: none;
  }
  .hero__cue:hover { color: var(--on-photo); }

  @media (max-width: 767px) {
    .hero__wordmark { font-size: clamp(3rem, 15.5vw, 5rem); }
    .hero__card { inline-size: clamp(72px, 20vw, 110px); }
    .hero__temp-tag { inset-block-end: 34vh; }
    .hero__cue { display: none; } /* touch: scrolling needs no cue; avoids kicker collision */
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Entrance + parallax only for motion-safe users; final layout is the CSS default.
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const lines = gsap.utils.toArray<HTMLElement>('[data-hero-line]');
    const card = document.querySelector('[data-hero-card]');
    const media = document.querySelector('[data-hero-media] img');
    const soft = gsap.utils.toArray<HTMLElement>('[data-hero-kicker]');

    const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
    tl.from(media, { scale: 1.06, duration: 1.4, ease: 'power2.out' }, 0)
      .from(lines, { yPercent: 110, duration: 0.9, stagger: 0.12 }, 0.15)
      .from(card, { scale: 0, rotate: 8, duration: 0.6, ease: 'back.out(1.4)' }, 0.75)
      .from(soft, { opacity: 0, y: 8, duration: 0.5, stagger: 0.08 }, 0.9);

    // Delay entrance until the loader finishes on first visit.
    if (document.documentElement.hasAttribute('data-loader')) {
      tl.pause();
      const start = () => tl.play();
      const obs = new MutationObserver(() => {
        if (document.documentElement.getAttribute('data-loader') !== 'on') {
          start();
          obs.disconnect();
        }
      });
      obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-loader'] });
      setTimeout(start, 1800); // safety net
    }

    // Conservative scroll parallax (pending reference recordings — MOTION_MAP ⏳)
    gsap.to(media, {
      yPercent: 8,
      ease: 'none',
      scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true },
    });
    gsap.to('.hero__wordmark', {
      yPercent: 12,
      ease: 'none',
      scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true },
    });
  });
</script>
