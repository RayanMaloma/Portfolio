---
// Playground — homepage band ONLY (revision 2026-07-18: the /playground page
// is removed; this section is the whole playground).
// Behavior per Rayan's spec:
//   · cursor outside the band → cards drift left → right automatically
//   · cursor over the band   → motion stops; drag freely left or right
// All 14 curated boards ride the band in PROJECT ORDER so each identity
// deck still reads sequentially while dragging. Cards keep intrinsic ratios.
// Touch: native horizontal scrolling. Reduced motion: static wrapped grid.
import ui from '../content/ui.json';

const cards = [
  // RKNH — brand identity (deck order)
  { src: '/assets/playground/rknh-1-s.webp', alt: 'RKNH brand guidelines cover', r: -3, w: 640, h: 360 },
  { src: '/assets/playground/rknh-3-s.webp', alt: 'RKNH logo usage: vertical, horizontal, symbol', r: 2, w: 640, h: 360 },
  { src: '/assets/playground/rknh-5-s.webp', alt: 'RKNH English type specimen', r: -2, w: 640, h: 360 },
  { src: '/assets/playground/rknh-7-s.webp', alt: 'RKNH get-in-touch board', r: 3, w: 640, h: 360 },
  // Routine — app brand & campaign content
  { src: '/assets/playground/routine-1-s.webp', alt: 'Routine App Store design preview', r: -2, w: 640, h: 438 },
  { src: '/assets/playground/routine-8-s.webp', alt: 'Routine identity board', r: 2, w: 640, h: 400 },
  { src: '/assets/playground/routine-16-s.webp', alt: 'Routine brand patterns', r: -3, w: 640, h: 400 },
  { src: '/assets/playground/routine-24-s.webp', alt: 'Routine coffee tips infographic', r: 2, w: 640, h: 898 },
  // Tamakkan — campaign design
  { src: '/assets/playground/tamakan-1-s.webp', alt: 'Tamakkan campaign poster', r: -2, w: 640, h: 480 },
  { src: '/assets/playground/tamakan-2-s.webp', alt: 'Tamakkan rollup banner', r: 3, w: 640, h: 640 },
  // Mosbah Omar — brand & packaging
  { src: '/assets/playground/mosbah-1-s.webp', alt: 'Mosbah Omar calligraphic logo colorways', r: -3, w: 640, h: 640 },
  { src: '/assets/playground/mosbah-3-s.webp', alt: 'Mosbah Omar Najdi-pattern packaging', r: 2, w: 640, h: 427 },
  { src: '/assets/playground/mosbah-5-s.webp', alt: 'Mosbah Omar best-seller banner', r: -2, w: 640, h: 247 },
  { src: '/assets/playground/mosbah-7-s.webp', alt: 'Mosbah Omar Ramadan banner', r: 2, w: 640, h: 247 },
];
---

<section class="pgt" id="playground" aria-label="Playground — graphic design work">
  <h2 class="pgt__word t-display" aria-hidden="true">{ui.playground.title.toUpperCase()}</h2>

  <div class="pgt__band" data-pgt-band tabindex="-1">
    <div class="pgt__track" data-pgt-track>
      {[0, 1].map((dup) => (
        <div class="pgt__group" aria-hidden={dup === 1 ? 'true' : undefined} data-pgt-group={dup === 0 ? '' : undefined}>
          {cards.map((c) => (
            <figure class="pgt__card" style={`--r:${c.r}deg; --ar:${c.w} / ${c.h};`}>
              <img src={c.src} alt={dup === 0 ? c.alt : ''} loading="lazy" decoding="async" width={c.w} height={c.h} />
            </figure>
          ))}
        </div>
      ))}
    </div>
  </div>

  <p class="pgt__caption t-meta">{ui.playground.teaserCaption}</p>
</section>

<style>
  .pgt {
    padding-block: var(--space-section);
    background: var(--bg-tint);
    overflow: hidden;
    scroll-margin-block-start: 80px; /* legacy redirect target */
  }

  .pgt__word {
    font-size: clamp(3rem, 11vw, 10rem);
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    line-height: 0.9;
    margin-block-end: -0.35em; /* overlaps the band */
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .pgt__band {
    position: relative;
    z-index: 1;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .pgt__band::-webkit-scrollbar { display: none; }
  @media (pointer: fine) {
    .pgt__band { cursor: grab; }
    .pgt__band.is-dragging { cursor: grabbing; }
    .pgt__band.is-dragging * { pointer-events: none; }
  }

  .pgt__track { display: flex; width: max-content; }
  .pgt__group { display: flex; gap: var(--space-5); padding-inline-end: var(--space-5); align-items: flex-start; }

  .pgt__card {
    margin: 0;
    inline-size: clamp(180px, 22vw, 320px);
    aspect-ratio: var(--ar); /* card boundary = artwork boundary */
    flex-shrink: 0;
    border-radius: var(--r-m);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transform: rotate(var(--r));
    transition: transform var(--dur-2) var(--ease-out);
    margin-block: var(--space-6); /* room for rotation only */
  }
  .pgt__card:hover { transform: rotate(0deg) translateY(-4px); }
  .pgt__card img { inline-size: 100%; block-size: 100%; display: block; }

  .pgt__caption {
    text-align: center;
    color: var(--ink-soft);
    margin-block-start: var(--space-5);
  }

  /* Reduced motion: static wrapped strip, no auto-motion, no duplication */
  @media (prefers-reduced-motion: reduce) {
    .pgt__band { overflow-x: visible; cursor: auto; }
    .pgt__track { flex-wrap: wrap; width: auto; justify-content: center; }
    .pgt__group[aria-hidden='true'] { display: none; }
    .pgt__card { transform: none; }
  }
</style>

<script>
  // Auto-drift LEFT → RIGHT while the cursor is away; full stop while the
  // pointer is over the band (drag/scroll freely); resume on leave.
  const band = document.querySelector<HTMLElement>('[data-pgt-band]');
  const group = document.querySelector<HTMLElement>('[data-pgt-group]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (band && group && !reduced) {
    const SPEED = 42; // px/s
    let hovered = false;
    let touched = false; // touch interaction parks auto-motion briefly
    let touchTimer: ReturnType<typeof setTimeout> | undefined;
    let last = performance.now();

    // Keep scrollLeft inside the first copy's range for a seamless loop
    const wrap = () => {
      const gw = group.offsetWidth;
      if (gw <= 0) return;
      if (band.scrollLeft <= 0) band.scrollLeft += gw;
      else if (band.scrollLeft > gw) band.scrollLeft -= gw;
    };

    const tick = (now: number) => {
      const dt = (now - last) / 1000;
      last = now;
      if (!hovered && !touched && !document.hidden) {
        band.scrollLeft -= SPEED * dt; // content travels left → right
        wrap();
      }
      requestAnimationFrame(tick);
    };
    band.scrollLeft = group.offsetWidth; // start at the seam so both directions wrap
    requestAnimationFrame(tick);

    // Pointer presence = full stop (per spec); resume when it leaves
    band.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hovered = true; });
    band.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { hovered = false; last = performance.now(); } });
    band.addEventListener('scroll', () => wrap(), { passive: true });

    // Touch: pause during interaction, resume shortly after
    const touchPause = () => {
      touched = true;
      clearTimeout(touchTimer);
      touchTimer = setTimeout(() => { touched = false; last = performance.now(); }, 2200);
    };
    band.addEventListener('touchstart', touchPause, { passive: true });
    band.addEventListener('touchmove', touchPause, { passive: true });

    // Mouse drag-to-scroll
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    band.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      startX = e.clientX;
      startScroll = band.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) band.classList.add('is-dragging');
      band.scrollLeft = startScroll - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      requestAnimationFrame(() => band.classList.remove('is-dragging'));
    });
  }
</script>
