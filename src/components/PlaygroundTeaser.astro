---
// Playground teaser (IA §3.6 + revision 2026-07-18).
// Cards derive height from each image's intrinsic aspect ratio (no fixed
// heights, no stretched containers). Desktop: JS-driven auto-marquee over a
// real scroll container — pauses on hover, drag-to-scroll (grab/grabbing),
// resumes after idle. Touch: native horizontal scrolling, auto-motion pauses
// on interaction. Reduced motion: static wrapped strip.
// Intrinsic dimensions below are read from the actual generated -s.webp files.
import ui from '../content/ui.json';

const cards = [
  { src: '/assets/playground/rknh-1-s.webp', alt: 'RKNH brand guidelines cover', r: -3, w: 640, h: 360 },
  { src: '/assets/playground/routine-1-s.webp', alt: 'Routine App Store design preview', r: 2, w: 640, h: 438 },
  { src: '/assets/playground/mosbah-1-s.webp', alt: 'Mosbah Omar calligraphic logo', r: -2, w: 640, h: 640 },
  { src: '/assets/playground/tamakan-1-s.webp', alt: 'Tamakkan campaign poster', r: 3, w: 640, h: 480 },
  { src: '/assets/playground/rknh-5-s.webp', alt: 'RKNH type specimen', r: 2, w: 640, h: 360 },
  { src: '/assets/playground/routine-24-s.webp', alt: 'Routine coffee infographic', r: -2, w: 640, h: 898 },
  { src: '/assets/playground/mosbah-3-s.webp', alt: 'Mosbah Omar packaging', r: 3, w: 640, h: 427 },
  { src: '/assets/playground/tamakan-2-s.webp', alt: 'Tamakkan rollup banner', r: -3, w: 640, h: 640 },
  { src: '/assets/playground/rknh-3-s.webp', alt: 'RKNH logo system', r: 2, w: 640, h: 360 },
  { src: '/assets/playground/routine-8-s.webp', alt: 'Routine identity board', r: -2, w: 640, h: 400 },
];
---

<section class="pgt" aria-label="Playground preview">
  <a class="pgt__head-link" href="/playground/" aria-label="Open the playground">
    <h2 class="pgt__word t-display" aria-hidden="true">{ui.playground.title.toUpperCase()}</h2>
  </a>

  <div class="pgt__band" data-pgt-band tabindex="-1">
    <div class="pgt__track" data-pgt-track>
      {[0, 1].map((dup) => (
        <div class="pgt__group" aria-hidden={dup === 1 ? 'true' : undefined} data-pgt-group={dup === 0 ? '' : undefined}>
          {cards.map((c) => (
            <figure class="pgt__card" style={`--r:${c.r}deg; --ar:${c.w} / ${c.h};`}>
              <img src={c.src} alt={dup === 0 ? c.alt : ''} loading="lazy" decoding="async" width={c.w} height={c.h} />
            </figure>
          ))}
        </div>
      ))}
    </div>
  </div>

  <p class="pgt__caption">
    <a class="pgt__caption-link" href="/playground/">
      <span class="pgt__caption-text">{ui.playground.teaserCaption}</span>
      <span class="pgt__arrow" aria-hidden="true">→</span>
    </a>
  </p>
</section>

<style>
  .pgt {
    padding-block: var(--space-section);
    background: var(--bg-tint);
    overflow: hidden;
  }
  .pgt__head-link { display: block; text-decoration: none; color: inherit; }

  .pgt__word {
    font-size: clamp(3rem, 11vw, 10rem);
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    line-height: 0.9;
    margin-block-end: -0.35em; /* overlaps the band */
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .pgt__band {
    position: relative;
    z-index: 1;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .pgt__band::-webkit-scrollbar { display: none; }
  @media (pointer: fine) {
    .pgt__band { cursor: grab; }
    .pgt__band.is-dragging { cursor: grabbing; }
    .pgt__band.is-dragging * { pointer-events: none; } /* no accidental interactions mid-drag */
  }

  .pgt__track { display: flex; width: max-content; }
  .pgt__group { display: flex; gap: var(--space-5); padding-inline-end: var(--space-5); align-items: flex-start; }

  .pgt__card {
    margin: 0;
    inline-size: clamp(180px, 22vw, 320px);
    aspect-ratio: var(--ar); /* card boundary = artwork boundary */
    flex-shrink: 0;
    border-radius: var(--r-m);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transform: rotate(var(--r));
    transition: transform var(--dur-2) var(--ease-out);
    margin-block: var(--space-6); /* room for rotation only — outside the card */
  }
  .pgt__card:hover { transform: rotate(0deg) translateY(-4px); }
  .pgt__card img { inline-size: 100%; block-size: 100%; display: block; }

  .pgt__caption {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-5);
  }
  .pgt__caption-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 550;
    color: var(--ink);
    text-decoration: none;
  }
  .pgt__caption-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1.5px;
    transition: background-size var(--dur-2) var(--ease-out);
    padding-block-end: 2px;
  }
  .pgt__caption-link:hover .pgt__caption-text,
  .pgt__caption-link:focus-visible .pgt__caption-text { background-size: 100% 1.5px; }
  .pgt__arrow { transition: transform var(--dur-1) var(--ease-out); color: var(--coral-deep); }
  .pgt__caption-link:hover .pgt__arrow { transform: translateX(4px); }

  /* Reduced motion: static wrapped strip, no auto-motion, no duplication */
  @media (prefers-reduced-motion: reduce) {
    .pgt__band { overflow-x: visible; cursor: auto; }
    .pgt__track { flex-wrap: wrap; width: auto; justify-content: center; }
    .pgt__group[aria-hidden='true'] { display: none; }
    .pgt__card { transform: none; }
  }
</style>

<script>
  // Auto-marquee + drag on a real scroll container. Seamless loop via the
  // duplicated group: wrap scrollLeft into [0, groupWidth).
  const band = document.querySelector<HTMLElement>('[data-pgt-band]');
  const group = document.querySelector<HTMLElement>('[data-pgt-group]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (band && group && !reduced) {
    const SPEED = 42; // px/s auto-advance
    const IDLE_RESUME = 2200; // ms after last interaction
    let paused = false;
    let idleTimer: ReturnType<typeof setTimeout> | undefined;
    let last = performance.now();

    const wrap = () => {
      const gw = group.offsetWidth;
      if (gw <= 0) return;
      if (band.scrollLeft >= gw) band.scrollLeft -= gw;
      else if (band.scrollLeft <= 0) band.scrollLeft += gw;
    };

    const tick = (now: number) => {
      const dt = (now - last) / 1000;
      last = now;
      if (!paused && !document.hidden) {
        band.scrollLeft += SPEED * dt;
        wrap();
      }
      requestAnimationFrame(tick);
    };
    band.scrollLeft = 1; // off the 0 edge so backward wrap works immediately
    requestAnimationFrame(tick);

    const interact = () => {
      paused = true;
      clearTimeout(idleTimer);
      idleTimer = setTimeout(() => { paused = false; last = performance.now(); }, IDLE_RESUME);
    };

    // Hover pause (fine pointers)
    band.addEventListener('pointerenter', () => { paused = true; clearTimeout(idleTimer); });
    band.addEventListener('pointerleave', () => interact());
    // Any manual scrolling (trackpad, touch, drag) pauses + wraps for the loop
    band.addEventListener('scroll', () => wrap(), { passive: true });
    band.addEventListener('wheel', interact, { passive: true });
    band.addEventListener('touchstart', interact, { passive: true });
    band.addEventListener('touchmove', interact, { passive: true });

    // Mouse drag-to-scroll (touch uses native scrolling)
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    band.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      startX = e.clientX;
      startScroll = band.scrollLeft;
      interact();
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) band.classList.add('is-dragging');
      band.scrollLeft = startScroll - dx;
      interact();
    });
    window.addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      // Delay class removal so a click released after dragging stays suppressed
      requestAnimationFrame(() => band.classList.remove('is-dragging'));
      interact();
    });
  }
</script>
