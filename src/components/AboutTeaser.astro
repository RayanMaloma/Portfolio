---
// About teaser (IA §3.7, approved). Coral-washed band; memoji as a die-cut
// sticker (P5: memoji stays, secondary and controlled); story + fact chips.
import ui from '../content/ui.json';
---

<section class="abt" aria-label="About preview">
  <div class="container abt__grid">
    <div class="abt__sticker-wrap">
      <img
        class="abt__sticker"
        src="/assets/memoji.webp"
        alt="Rayan's memoji character"
        loading="lazy"
        decoding="async"
        width="320"
        data-critical
        data-reveal
      />
    </div>

    <div class="abt__body">
      <p class="t-meta abt__label" data-reveal>{ui.aboutTeaser.label}</p>
      <p class="abt__story" data-reveal>{ui.aboutTeaser.story}</p>
      <ul class="abt__chips t-meta" data-reveal>
        {ui.aboutTeaser.chips.map((c) => <li>{c}</li>)}
      </ul>
      <a class="abt__cta" href="/about/" data-reveal>
        <span class="abt__cta-text">{ui.aboutTeaser.cta}</span>
        <span class="abt__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .abt {
    /* Option C (final, decision 24): sand + restrained cobalt tint —
       distinct from the coral foundation, the pink world, and the playground */
    background: color-mix(in srgb, var(--cobalt) 5%, var(--bg-base));
    padding-block: var(--space-9);
    overflow: visible;
  }
  .abt__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    align-items: center;
  }

  .abt__sticker-wrap { grid-column: 1 / span 4; display: flex; justify-content: center; }
  /* Transparent cutout, not an avatar: no circle, no frame, no shadow box.
     Larger, slightly overlapping the band so it feels placed in the layout. */
  .abt__sticker {
    inline-size: clamp(200px, 24vw, 320px);
    transform: rotate(-4deg);
    margin-block: calc(var(--space-7) * -1) calc(var(--space-4) * -1);
    filter: drop-shadow(0 12px 28px rgba(34, 29, 22, 0.14));
    transition: transform var(--dur-2) var(--ease-out);
  }
  .abt:hover .abt__sticker { transform: rotate(-1deg) translateY(-4px); }

  .abt__body { grid-column: 6 / span 6; }
  .abt__label { color: var(--coral-deep); }
  .abt__story {
    margin-block-start: var(--space-3);
    font-size: var(--text-lead);
    line-height: 1.5;
    max-inline-size: 46ch;
    color: var(--ink);
  }
  .abt__chips {
    list-style: none;
    display: flex;
    gap: var(--space-2) var(--space-3);
    flex-wrap: wrap;
    padding: 0;
    margin-block-start: var(--space-5);
    color: var(--ink-soft);
  }
  .abt__chips li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    padding: var(--space-1) var(--space-3);
  }
  .abt__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-5);
    font-weight: 550;
    color: var(--ink);
    text-decoration: none;
  }
  .abt__cta-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1.5px;
    transition: background-size var(--dur-2) var(--ease-out);
    padding-block-end: 2px;
  }
  .abt__cta:hover .abt__cta-text, .abt__cta:focus-visible .abt__cta-text { background-size: 100% 1.5px; }
  .abt__arrow { color: var(--coral-deep); transition: transform var(--dur-1) var(--ease-out); }
  .abt__cta:hover .abt__arrow { transform: translateX(4px); }

  @media (max-width: 1023px) {
    .abt__grid { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-5); }
    .abt__sticker { inline-size: 180px; margin-block: calc(var(--space-6) * -1) 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .abt__sticker { transition: none; transform: none; }
  }
</style>
