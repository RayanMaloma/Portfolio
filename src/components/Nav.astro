---
import { SITE } from '../config/site';
import ui from '../content/ui.json';
const path = Astro.url.pathname;
---

<header class="nav" data-nav>
  <a class="nav__brand" href="/">
    <span class="nav__brand-full">{SITE.name}</span>
    <span class="nav__brand-short" aria-hidden="true">R.A.</span>
  </a>

  <nav class="nav__pill" aria-label="Primary">
    <a href="/#work" class="nav__item">{ui.nav.work}</a>
    <a href="/" class="nav__mark" aria-label="Home" aria-current={path === '/' ? 'page' : undefined}>✦</a>
    <a href="/about" class="nav__item" aria-current={path.startsWith('/about') ? 'page' : undefined}>{ui.nav.about}</a>
  </nav>

  <div class="nav__links">
    <a class="nav__glass" href={`mailto:${SITE.email}`} aria-label={ui.nav.email} title={ui.nav.email}>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="5.5" width="18" height="13" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
        <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    <a class="nav__glass" href={SITE.links.linkedin} target="_blank" rel="noopener" aria-label={ui.nav.linkedin} title={ui.nav.linkedin}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.4 8.5h4.2V23H.4V8.5zm7.1 0h4v2h.06c.56-1.06 1.93-2.18 3.97-2.18 4.25 0 5.03 2.8 5.03 6.44V23h-4.2v-7.3c0-1.74-.03-3.98-2.42-3.98-2.42 0-2.8 1.9-2.8 3.86V23H7.5V8.5z"/>
      </svg>
    </a>
  </div>
</header>

<style>
  .nav {
    /* Ink swaps to the hero's on-photo cream while the nav floats over the
       photograph (home, unscrolled); back to warm ink on light grounds. */
    --nav-ink: var(--ink);
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--gutter);
    pointer-events: none; /* children re-enable; lets clicks pass between groups */
    transition: transform var(--dur-2) var(--ease-out);
  }
  :global(body:has([data-hero])) .nav:not(.is-scrolled) { --nav-ink: var(--on-photo); }
  .nav.is-hidden { transform: translateY(-120%); }
  .nav > * { pointer-events: auto; }

  .nav__brand {
    font-size: var(--text-meta);
    font-weight: 550;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--nav-ink);
    transition: color var(--dur-2) var(--ease-out);
  }
  .nav__brand-short { display: none; }

  .nav__pill {
    position: absolute;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--r-pill);
    border: 1px solid transparent;
    transition: background var(--dur-2), border-color var(--dur-2), box-shadow var(--dur-2);
  }
  .nav.is-scrolled .nav__pill {
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    border-color: var(--border);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(10px);
  }
  .nav__item {
    font-size: var(--text-meta);
    font-weight: 550;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--nav-ink);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--r-pill);
    transition: background var(--dur-1), color var(--dur-2) var(--ease-out);
  }
  .nav__item:hover { background: color-mix(in srgb, var(--coral-soft) 45%, transparent); }
  .nav__mark {
    color: var(--coral-deep);
    text-decoration: none;
    font-size: 1rem;
    padding-inline: var(--space-2);
  }
  /* Brighter coral over the photograph — deep coral sinks into the warm tones */
  :global(body:has([data-hero])) .nav:not(.is-scrolled) .nav__mark { color: var(--coral); }
  :global(body:has([data-hero])) .nav:not(.is-scrolled) .nav__item:hover {
    background: color-mix(in srgb, var(--ink) 28%, transparent);
  }
  .nav__item[aria-current='page'],
  .nav__mark[aria-current='page'] { position: relative; }

  .nav__links { display: flex; gap: var(--space-3); }
  /* Liquid-glass circles: near-transparent fill so the photograph reads
     through, deep blur + saturation, luminous edge and top sheen */
  .nav__glass {
    display: grid;
    place-items: center;
    inline-size: 42px;
    block-size: 42px;
    border-radius: 50%;
    color: var(--nav-ink);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--surface) 28%, transparent),
      color-mix(in srgb, var(--surface) 4%, transparent) 55%,
      color-mix(in srgb, var(--surface) 12%, transparent)
    );
    border: 1px solid color-mix(in srgb, var(--surface) 40%, transparent);
    backdrop-filter: blur(20px) saturate(1.8);
    -webkit-backdrop-filter: blur(20px) saturate(1.8);
    box-shadow:
      inset 0 1px 1px color-mix(in srgb, var(--surface) 65%, transparent),
      inset 0 -1px 1px color-mix(in srgb, var(--surface) 10%, transparent),
      0 8px 24px rgba(34, 29, 22, 0.16);
    transition: background var(--dur-1), color var(--dur-1), transform var(--dur-1);
  }
  .nav__glass:hover { background: var(--coral); color: var(--surface); transform: translateY(-1px); }

  @media (max-width: 767px) {
    .nav__brand-full { display: none; }
    .nav__brand-short { display: inline; }
    .nav__links { display: none; } /* contact lives in the footer on mobile */
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]');
  if (nav) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      nav.classList.toggle('is-scrolled', y > 40);
      // Hide on down-scroll, reveal on up-scroll (never while near the top)
      if (y > 160 && y > lastY + 4) nav.classList.add('is-hidden');
      else if (y < lastY - 4 || y <= 160) nav.classList.remove('is-hidden');
      lastY = y;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  }
</script>
