---
// Selected Work (IA §3.4, approved). Three flagship blocks; the section
// background cross-fades between light project WASHES when a block becomes
// dominant in the viewport — discrete transitions, no per-pixel interpolation.
import { getCollection } from 'astro:content';
import ProjectBlock from './ProjectBlock.astro';
import ui from '../../content/ui.json';
import '../../styles/themes.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section class="work" id="work" data-work aria-label="Selected work">
  <!-- Wash cross-fade layers: opacity-only (compositor-friendly) — animating
       background-color repainted the whole multi-viewport section every frame -->
  <div class="work__washes" aria-hidden="true">
    {projects.map((p) => <span class="work__wash" data-theme={p.id} data-wash={p.id}></span>)}
  </div>
  <div class="container">
    <header class="work__head">
      <p class="t-meta work__label" data-block-reveal>{ui.work.label} (01–{String(projects.length).padStart(2, '0')})</p>
      <p class="t-meta work__hint" data-block-reveal>{ui.work.hint}</p>
    </header>

    <div class="work__list">
      {projects.map((p, i) => <ProjectBlock project={p} index={i} />)}
    </div>
  </div>
</section>

<style>
  .work {
    position: relative;
    background: var(--bg-base);
    padding-block: var(--space-section);
    overflow-x: clip; /* decorative frame overhangs must never scroll the page */
  }
  .work > .container { position: relative; z-index: 1; }
  /* Each layer resolves --wash from its own [data-theme] scope; the active one
     fades in with opacity — GPU-composited, no per-frame section repaint */
  .work__washes { position: absolute; inset: 0; pointer-events: none; }
  .work__wash {
    position: absolute;
    inset: 0;
    background: var(--wash);
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .work__wash.is-active { opacity: 1; }
  .work__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
    color: var(--ink-soft);
    border-block-end: 1px solid var(--border);
    padding-block-end: var(--space-4);
  }
  /* On wash backgrounds coral-deep (3.5:1) and muted (3.1:1) fail 4.5:1 —
     the label rides each world's deep accent; the hint uses ink-soft */
  .work__label { color: var(--accent-deep, var(--coral-deep)); transition: color var(--dur-3) var(--ease-out); }
  .work__hint { color: var(--ink-soft); }
  .work__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    margin-block-start: var(--space-8);
  }
  @media (prefers-reduced-motion: reduce) {
    .work__wash { transition: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('[data-work]');
  const blocks = gsap.utils.toArray<HTMLElement>('[data-work-block]');
  const washes = gsap.utils.toArray<HTMLElement>('[data-wash]');

  // ── Wash cross-fade: discrete theme swap when a block dominates ──
  // Reduced-motion users get it too (it's information, transition is CSS-gated).
  if (section && blocks.length) {
    const setTheme = (id: string | undefined) => {
      if (id) section.dataset.theme = id;
      else delete section.dataset.theme;
      washes.forEach((w) => w.classList.toggle('is-active', w.dataset.wash === id));
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setTheme((e.target as HTMLElement).dataset.project);
        }
      },
      // "Dominant" = block crosses the middle band of the viewport
      { rootMargin: '-45% 0px -45% 0px' }
    );
    blocks.forEach((b) => io.observe(b));

    // Back to the base ground when the whole section leaves view
    const reset = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (!e.isIntersecting) setTheme(undefined); }),
      { threshold: 0 }
    );
    reset.observe(section);
  }

  // ── Entrance choreography (motion-safe only; CSS default = final state) ──
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    blocks.forEach((block) => {
      const media = block.querySelector('[data-block-media]');
      const title = block.querySelector('[data-block-title]');
      const rest = block.querySelectorAll('[data-block-reveal]');

      const tl = gsap.timeline({
        defaults: { ease: 'power4.out' },
        scrollTrigger: { trigger: block, start: 'top 72%', once: true },
      });
      // Curtain reveal with 20% outset margins: inset(0 ...) hard-clipped the
      // card shadows and the overhanging supporting screens mid-animation
      // (visible popping). clearProps removes the clip (and layer hint) at rest.
      tl.fromTo(
        media,
        { clipPath: 'inset(-20% -20% 115% -20%)', willChange: 'clip-path' },
        { clipPath: 'inset(-20% -20% -20% -20%)', duration: 0.8, clearProps: 'clipPath,willChange' },
        0
      )
        .from(title, { yPercent: 110, duration: 0.7 }, 0.15)
        .from(rest, { opacity: 0, y: 10, duration: 0.45, stagger: 0.06 }, 0.3);
    });

    // Section header reveal
    gsap.from('.work__head [data-block-reveal]', {
      opacity: 0,
      y: 10,
      duration: 0.45,
      stagger: 0.08,
      ease: 'power4.out',
      scrollTrigger: { trigger: '.work__head', start: 'top 85%', once: true },
    });
  });
</script>
