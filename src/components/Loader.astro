---
// Branded micro-loader + readiness gate (IA §3.1, revised decision 25).
// Holds the curtain until fonts and every [data-critical] image are decoded,
// so entrances and scroll reveals play on fully-ready pixels. Cap 3.5s.
interface Props { line: string }
const { line } = Astro.props;
---

<div class="loader" aria-hidden="true">
  <span class="loader__bar"></span>
  <span class="loader__mark t-display">Rayan <i>✦</i> Al-Omaireeni</span>
  <span class="loader__line t-meta">{line}</span>
</div>

<style>
  .loader { display: none; }

  :global(html[data-loader='on']) .loader {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: var(--z-loader);
    background: var(--bg-base);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    transition: opacity var(--dur-2) var(--ease-out);
  }
  :global(html[data-loader='done']) .loader { opacity: 0; pointer-events: none; }

  .loader__bar {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    block-size: 3px;
    inline-size: 100%;
    background: var(--coral);
    transform-origin: 0 50%;
    animation: load-bar 2.4s var(--ease-inout) forwards;
  }
  @keyframes load-bar {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  .loader__mark { font-size: 1.25rem; font-weight: 600; }
  .loader__mark i { font-style: normal; color: var(--coral-deep); }
  .loader__line { color: var(--muted); }
</style>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const html = document.documentElement;
  if (html.getAttribute('data-loader') === 'on') {
    const started = performance.now();
    const MIN_SHOW = 900; // let the brand moment register
    const CAP = 3500; // never hold the visitor hostage

    const finish = () => {
      if (html.getAttribute('data-loader') !== 'on') return;
      html.setAttribute('data-loader', 'done');
      // Layout is final now (fonts + images sized) — recalibrate scroll triggers
      requestAnimationFrame(() => ScrollTrigger.refresh());
      setTimeout(() => html.removeAttribute('data-loader'), 600);
    };

    // Readiness = fonts + every critical image fetched AND decoded.
    const criticals = Array.from(document.querySelectorAll<HTMLImageElement>('img[data-critical]'));
    const ready = Promise.allSettled([
      document.fonts?.ready ?? Promise.resolve(),
      ...criticals.map((img) => img.decode().catch(() => {})),
    ]);

    ready.then(() => {
      const elapsed = performance.now() - started;
      setTimeout(finish, Math.max(0, MIN_SHOW - elapsed));
    });
    setTimeout(finish, CAP);
  }
</script>
